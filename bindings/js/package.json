{
  "name": "kotva-client",
  "version": "0.1.0",
  "description": "Browser/JS implementation of the KOTVA substrate protocols: DMTAP-PUB chunk-tree range proofs (substrate/FEEDS.md §5.3), the relay-box AEAD wire format, X3DH forward-secret content keys, authenticated signaling, and the key-addressed rendezvous client.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chunkProof": "./src/chunkProof.ts",
    "./relayBox": "./src/relayBox.ts",
    "./prekeys": "./src/prekeys.ts",
    "./signaling": "./src/signaling.ts",
    "./rendezvous": "./src/rendezvous.ts",
    "./rendezvousSignaling": "./src/rendezvousSignaling.ts",
    "./secureTransport": "./src/secureTransport.ts",
    "./errors": "./src/errors.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE-MIT"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:lint-config": "node scripts/check-lint-config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vul-os/kotva.git",
    "directory": "bindings/js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.7"
  }
}
